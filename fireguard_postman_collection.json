    {
      "name": "5. Operator (Admin Dashboard)",
      "item": [
        {
          "name": "Login Operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "if (setCookie) {",
                  "    var match = setCookie.match(/auth_token=([^;]+)/);",
                  "    if (match && match[1]) {",
                  "        pm.collectionVariables.set(\"operatorToken\", match[1]);",
                  "        console.log(\"Operator Token saved:\", match[1]);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
