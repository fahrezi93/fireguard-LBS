# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fireguard

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key

# OTP hash secret untuk verifikasi OTP (generate random 32+ chars)
OTP_HASH_SECRET=your-super-secret-otp-key

# Aktif/nonaktif fallback login OTP untuk akun lama tanpa password_hash
AUTH_OTP_LOGIN_FALLBACK=true

# Resend — Email API (menggantikan Gmail SMTP yang diblokir DigitalOcean)
# 1. Daftar di https://resend.com (gratis 3.000 email/bulan)
# 2. Buat API key di https://resend.com/api-keys
# 3. Verifikasi domain di https://resend.com/domains (tambahkan DNS record ke domain kamu)
# 4. Setelah domain terverifikasi, isi RESEND_FROM_EMAIL dengan alamat dari domain tersebut
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=FireGuard <noreply@your-domain.com>

# Gmail SMTP — TIDAK DIGUNAKAN LAGI (diblokir DigitalOcean)
# Variabel ini bisa dihapus, disimpan hanya sebagai referensi
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password-here

# WhatsApp via Fonnte (Opsional - hanya jika ingin notifikasi via WA juga)
ENABLE_WHATSAPP=false
FONNTE_TOKEN=your_fonnte_token

# Node Environment
NODE_ENV=development

# Timezone — wajib di VPS agar MySQL dan log menggunakan WIB
TZ=Asia/Jakarta

# CORS — daftar origin yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://fireguard.example.com,https://app.fireguard.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Base URL untuk asset publik (wajib di production)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Android TWA / Play Store
ANDROID_PACKAGE_NAME=com.yourcompany.fireguard
ANDROID_SHA256_CERT_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# Firebase Admin SDK Configuration
# Service account key JSON (download from Firebase Console > Project Settings > Service Accounts)
# Format: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudinary — untuk upload foto laporan (gratis di cloudinary.com)
# 1. Daftar di cloudinary.com
# 2. Masuk Dashboard → Settings → Upload → Add upload preset → Signing Mode: Unsigned
# 3. Isi cloud name (ada di sudut kiri atas dashboard) dan preset name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name
